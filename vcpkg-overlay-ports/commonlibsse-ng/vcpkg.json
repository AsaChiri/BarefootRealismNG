{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "commonlibsse-ng",
  "version-semver": "4.18.0",
  "port-version": 1,
  "description": "Overlay port that swaps Color-Glass's CommonLibSSE-NG 3.7.0 for alandtse/CommonLibVR's `ng` branch (4.18.0) — adds named fields such as bhkCharacterController::surfaceMaterial and many other reverse-engineering refinements.",
  "homepage": "https://github.com/alandtse/CommonLibVR",
  "license": "MIT",
  "supports": "windows & x64",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "directxmath",
      "version>=": "2025-04-03"
    },
    {
      "name": "directxtk",
      "version>=": "2025-10-27"
    },
    {
      "name": "fmt",
      "version>=": "12.1.0"
    },
    {
      "name": "rapidcsv",
      "version>=": "8.90"
    },
    {
      "name": "spdlog",
      "version>=": "1.16.0"
    },
    {
      "name": "xbyak",
      "version>=": "7.28"
    }
  ]
}
